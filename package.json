{
  "name": "right-image-preview",
  "version": "0.4.0-beta.1",
  "type": "module",
  "description": "A dependency-free React image preview component with Lightroom-style discrete zoom stops, multi-group navigation, flip/rotate, auto-fade controls, and full keyboard support.",
  "keywords": [
    "react",
    "image-preview",
    "lightbox",
    "zoom",
    "typescript",
    "image-viewer",
    "gallery",
    "photo-viewer",
    "no-dependencies"
  ],
  "license": "MIT",
  "author": "ZhangJian <zhangjian1713@gmail.com>",
  "homepage": "https://github.com/ZhangJian1713/right-image-preview#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhangJian1713/right-image-preview.git"
  },
  "bugs": {
    "url": "https://github.com/ZhangJian1713/right-image-preview/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && node scripts/fix-dts-import-extensions.mjs",
    "build:lib:release": "RIP_CLEAR_LOCAL_BUILD=1 npm run build:lib",
    "pack:local": "node scripts/pack-local.mjs",
    "prepublishOnly": "node -e \"try{require('fs').unlinkSync('.local-build-at')}catch{}\" && RIP_CLEAR_LOCAL_BUILD=1 npm run build:lib",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "size-limit": [
    {
      "path": "./dist/index.mjs",
      "limit": "47 kB",
      "gzip": true
    }
  ],
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "size-limit": "^12.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  }
}
